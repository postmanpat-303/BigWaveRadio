; BigWave Radio - Windows x64 setup (NSIS 3, cross-buildable with makensis on Linux)
; Same layout as postmanpat-303/ChipWaveTracker installer/chipwave.nsi.
; Build: scripts/package-windows.sh 0.9.5
;   (makensis -DVERSION=0.9.5 -DVIVERSION=0.9.5.0 -DPKGDIR=../dist/pkg -DOUTFILE=../dist/BigWaveRadio-0.9.5-setup-x64.exe installer/bigwave.nsi)
; Silent install: BigWaveRadio-<ver>-setup-x64.exe /S   (desktop shortcut included by default)
Unicode true
!include "MUI2.nsh"
!include "x64.nsh"
!include "LogicLib.nsh"

!ifndef VERSION
  !define VERSION "0.0.0"
!endif
!ifndef PKGDIR
  !define PKGDIR "..\dist\pkg"
!endif
!ifndef OUTFILE
  !define OUTFILE "..\dist\BigWaveRadio-${VERSION}-setup-x64.exe"
!endif

!define APPNAME "BigWave Radio"
!define EXE "BigWaveRadio.exe"
!define PUBLISHER "Derek Heasley"
!define UNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\BigWaveRadio"
!define ICON "..\assets\bigwave.ico"
; Inno Setup per-user installs (0.9.3 and older) used this AppId.
!define OLD_INNO_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\{8F3C2A41-7B1E-4D5A-9C60-B2E44F6A21D3}_is1"

Name "${APPNAME} ${VERSION}"
OutFile "${OUTFILE}"
InstallDir "$PROGRAMFILES64\${APPNAME}"
InstallDirRegKey HKLM "Software\BigWaveRadio" "InstallDir"
RequestExecutionLevel admin
SetCompressor /SOLID lzma
BrandingText "${APPNAME} ${VERSION}"

!ifndef VIVERSION
  !define VIVERSION "${VERSION}"
!endif
VIProductVersion "${VIVERSION}"
VIAddVersionKey "ProductName" "${APPNAME}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "FileDescription" "${APPNAME} setup"
VIAddVersionKey "LegalCopyright" "MIT, (c) 2026 Derek Heasley"
VIAddVersionKey "CompanyName" "${PUBLISHER}"

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"
; Wolf branding (generated by scripts/make_branding.py)
!define MUI_WELCOMEFINISHPAGE_BITMAP "welcome.bmp"
!define MUI_UNWELCOMEFINISHPAGE_BITMAP "welcome.bmp"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_RIGHT
!define MUI_HEADERIMAGE_BITMAP "header.bmp"
!define MUI_HEADERIMAGE_UNBITMAP "header.bmp"
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\${EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Start BigWave Radio"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${PKGDIR}\LICENSE.txt"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

; BigWave keeps running in the tray when its window is closed, so close it
; first or its files can't be replaced.
!macro CLOSE_RUNNING UN
; Leaves 1 in $0 when a BigWaveRadio.exe process exists, else 0.
; Toolhelp snapshot via the System plugin (32-bit PROCESSENTRY32W = 556 bytes);
; sees 64-bit processes too and needs no tasklist/find parsing.
Function ${UN}IsRunning
  StrCpy $0 0
  System::Call 'kernel32::CreateToolhelp32Snapshot(i 2, i 0) p .r4'
  ${If} $4 P<> -1
    System::Call '*(i 556, &l552) p .r5'
    System::Call 'kernel32::Process32FirstW(p r4, p r5) i .r6'
    ${DoWhile} $6 <> 0
      System::Call '*$5(i, i, i, i, i, i, i, i, i, &w260 .r7)'
      ${If} $7 == "${EXE}"
        StrCpy $0 1
        ${ExitDo}
      ${EndIf}
      System::Call 'kernel32::Process32NextW(p r4, p r5) i .r6'
    ${Loop}
    System::Free $5
    System::Call 'kernel32::CloseHandle(p r4)'
  ${EndIf}
FunctionEnd

Function ${UN}CloseRunning
  Call ${UN}IsRunning
  ${If} $0 == 1
    MessageBox MB_OKCANCEL|MB_ICONINFORMATION "BigWave Radio is running (it may be in the tray). It will be closed to continue." /SD IDOK IDOK +2
    Abort
    nsExec::Exec 'taskkill /F /IM "${EXE}"'
    Pop $0
    ; wait (up to ~6 s) until it has really exited and released its files
    StrCpy $2 0
    ${Do}
      Sleep 300
      Call ${UN}IsRunning
      IntOp $2 $2 + 1
      ${If} $2 >= 20
        ${ExitDo}
      ${EndIf}
    ${LoopUntil} $0 == 0
    Sleep 500
  ${EndIf}
FunctionEnd
!macroend
!insertmacro CLOSE_RUNNING ""
!insertmacro CLOSE_RUNNING "un."

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP "BigWave Radio needs 64-bit Windows." /SD IDOK
    Abort
  ${EndIf}
  SetRegView 64
  Call CloseRunning
FunctionEnd

Function un.onInit
  SetRegView 64
  Call un.CloseRunning
FunctionEnd

; Tell Explorer icons/shortcuts changed (SHCNE_ASSOCCHANGED) so the new
; wolf icon replaces cached copies of the old one without a sign-out.
!macro REFRESH_SHELL_ICONS
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

Section "BigWave Radio (required)" SecCore
  SectionIn RO

  ; Upgrade from the old Inno Setup per-user build (0.9.3 and older): uninstall it
  ; silently (library, ratings and settings in %LOCALAPPDATA%\BigWaveRadio stay),
  ; then drop any of its shortcuts that are left so only the new ones remain.
  SetShellVarContext current
  ReadRegStr $0 HKCU "${OLD_INNO_KEY}" "UninstallString"
  ReadRegStr $3 HKCU "${OLD_INNO_KEY}" "Inno Setup: App Path"
  ${If} $0 != ""
    DetailPrint "Removing the previous BigWave Radio (per-user install)..."
    ExecWait '$0 /VERYSILENT /SUPPRESSMSGBOXES /NORESTART'
    ; anything the old uninstaller left behind (e.g. the old exe with the wave icon)
    ${If} $3 != ""
      Delete "$3\${EXE}"
      Delete "$3\libunwind.dll"
      Delete "$3\bigwave.ico"
      Delete "$3\README.txt"
      Delete "$3\unins000.exe"
      Delete "$3\unins000.dat"
      RMDir "$3"
    ${EndIf}
    Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
    Delete "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk"
    RMDir "$SMPROGRAMS\${APPNAME}"
    Delete "$DESKTOP\${APPNAME}.lnk"
    DeleteRegKey HKCU "${OLD_INNO_KEY}"
  ${EndIf}

  SetShellVarContext all
  SetOutPath "$INSTDIR"
  SetOverwrite on
  File "${PKGDIR}\${EXE}"
  File "${PKGDIR}\libunwind.dll"
  File "${PKGDIR}\README.txt"
  File "${PKGDIR}\LICENSE.txt"
  File "${PKGDIR}\THIRD_PARTY_LICENSES.txt"
  File "/oname=bigwave.ico" "${ICON}"
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Shortcuts take the icon from the exe resource, so they always match the exe.
  ; (Re)created on every install, so an upgrade replaces any stale shortcut.
  CreateDirectory "$SMPROGRAMS\${APPNAME}"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\${EXE}" 0
  CreateShortcut "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk" "$INSTDIR\Uninstall.exe" "" "$INSTDIR\bigwave.ico" 0

  WriteRegStr HKLM "Software\BigWaveRadio" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTKEY}" "DisplayName" "${APPNAME}"
  WriteRegStr HKLM "${UNINSTKEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKLM "${UNINSTKEY}" "Publisher" "${PUBLISHER}"
  WriteRegStr HKLM "${UNINSTKEY}" "DisplayIcon" "$INSTDIR\${EXE},0"
  WriteRegStr HKLM "${UNINSTKEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "${UNINSTKEY}" "URLInfoAbout" "https://github.com/postmanpat-303/BigWaveRadio"
  WriteRegStr HKLM "${UNINSTKEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKLM "${UNINSTKEY}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegDWORD HKLM "${UNINSTKEY}" "NoModify" 1
  WriteRegDWORD HKLM "${UNINSTKEY}" "NoRepair" 1
  !insertmacro REFRESH_SHELL_ICONS
SectionEnd

Section "Desktop shortcut" SecDesktop
  SetShellVarContext all
  Delete "$DESKTOP\${APPNAME}.lnk"
  CreateShortcut "$DESKTOP\${APPNAME}.lnk" "$INSTDIR\${EXE}" "" "$INSTDIR\${EXE}" 0
  !insertmacro REFRESH_SHELL_ICONS
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SecCore} "The player, its licence and third-party notices, Start Menu shortcuts and the uninstaller."
  !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} "Put a BigWave Radio shortcut on the desktop."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
  SetShellVarContext all
  Delete "$DESKTOP\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\Uninstall ${APPNAME}.lnk"
  RMDir "$SMPROGRAMS\${APPNAME}"
  Delete "$INSTDIR\${EXE}"
  Delete "$INSTDIR\libunwind.dll"
  Delete "$INSTDIR\README.txt"
  Delete "$INSTDIR\LICENSE.txt"
  Delete "$INSTDIR\THIRD_PARTY_LICENSES.txt"
  Delete "$INSTDIR\bigwave.ico"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR"
  DeleteRegKey HKLM "${UNINSTKEY}"
  DeleteRegKey HKLM "Software\BigWaveRadio"
  !insertmacro REFRESH_SHELL_ICONS
  ; library, ratings, settings and plugins in %LOCALAPPDATA%\BigWaveRadio are left alone
SectionEnd

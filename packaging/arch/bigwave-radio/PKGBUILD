# Maintainer: Del (postmanpat) <326151156+postmanpat-303@users.noreply.github.com>
# BigWave Radio built from source (the release tag).
# Build:  makepkg -si      (CachyOS / Arch / Manjaro / EndeavourOS)
pkgname=bigwave-radio
pkgver=0.9.9
pkgrel=1
pkgdesc="Internet radio player with moods, star ratings, plugins and visualisers (radio-browser.info)"
arch=('x86_64' 'aarch64')
url="https://github.com/postmanpat-303/BigWaveRadio"
license=('MIT')
depends=('alsa-lib' 'openssl' 'gcc-libs' 'glibc' 'libxkbcommon' 'libxkbcommon-x11' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'wayland' 'libglvnd' 'hicolor-icon-theme')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "BigWaveRadio-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "BigWaveRadio-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p bwr-app
}

check() {
  cd "BigWaveRadio-$pkgver"
  ./target/release/bwr-app --check-plugin plugins/visions
}

package() {
  cd "BigWaveRadio-$pkgver"
  install -Dm755 target/release/bwr-app "$pkgdir/usr/bin/bigwave-radio"
  install -Dm644 packaging/linux/bigwave-radio.desktop "$pkgdir/usr/share/applications/bigwave-radio.desktop"
  install -Dm644 packaging/linux/bigwave-radio.metainfo.xml "$pkgdir/usr/share/metainfo/bigwave-radio.metainfo.xml"
  for s in 16 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/bigwave-radio_$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/bigwave-radio.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
